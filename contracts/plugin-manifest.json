{
  "manifest_version": 1,
  "host_api": "1",
  "id": "org.wordflowlab.story-translation",
  "version": "0.1.0",
  "display": {
    "zh-CN": "译稿工坊",
    "en": "Story Translation"
  },
  "description": {
    "zh-CN": "按固定源文管理译稿、对齐、术语和意见，让局部返工与双语交付可接续。",
    "en": "Story Translation with fixed sources and external Agent workflows."
  },
  "license": "Apache-2.0",
  "dependencies": [],
  "work_kinds": [
    "novel"
  ],
  "runtime": {
    "entry": "backend.mjs"
  },
  "contributions": {
    "views": [
      {
        "id": "main",
        "title": "译稿工坊",
        "entry": "index.html",
        "object_kinds": [
          "story_translation"
        ],
        "navigation": "integrated"
      }
    ],
    "data": [
      {
        "kind": "story_translation",
        "schema_version": "1.0.0",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format_version": {
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "alignments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "source_ranges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "source_index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "byte_start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "byte_end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 32000
                        }
                      },
                      "required": [
                        "source_index",
                        "byte_start",
                        "byte_end",
                        "quote"
                      ]
                    },
                    "maxItems": 50
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "maxItems": 50
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "reviewed",
                      "needs_revision"
                    ]
                  }
                },
                "required": [
                  "id",
                  "title",
                  "source_ranges",
                  "targets",
                  "status"
                ]
              },
              "maxItems": 300
            },
            "terms": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "preferred",
                      "required",
                      "forbidden"
                    ]
                  },
                  "case_sensitive": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "id",
                  "source",
                  "target",
                  "mode",
                  "case_sensitive",
                  "note"
                ]
              },
              "maxItems": 300
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "alignment_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "target_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "comment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "resolved",
                      "dismissed"
                    ]
                  },
                  "resolution": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 4000
                  },
                  "recheck_sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title",
                  "alignment_id",
                  "target_sha256",
                  "comment",
                  "status",
                  "resolution",
                  "recheck_sha256"
                ]
              },
              "maxItems": 300
            },
            "source_language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "target_language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "scope_indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "maxItems": 100
            },
            "basis_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "owner_plugin_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "object_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "owner_plugin_id",
                  "object_id",
                  "revision",
                  "sha256"
                ]
              },
              "maxItems": 20
            }
          },
          "required": [
            "format_version",
            "title",
            "alignments",
            "terms",
            "issues",
            "source_language",
            "target_language",
            "scope_indices",
            "basis_refs"
          ]
        }
      }
    ],
